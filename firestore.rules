rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if a user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Announcements: Public read, admin-only write
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles: Owner or admin access
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }

    // Books: Public read, author-or-admin write
    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth.uid == resource.data.authorId || isAdmin();
    }

    // Chapters: Public read, author-or-admin write
    match /books/{bookId}/chapters/{chapterId} {
        allow read: if true;
        allow write: if get(/databases/$(database)/documents/books/$(bookId)).data.authorId == request.auth.uid || isAdmin();
    }

    // Follows: Authenticated users can read and write
    match /users/{userId}/following/{followedId} {
        allow read, write: if request.auth != null;
    }
    match /users/{userId}/followers/{followerId} {
        allow read, write: if request.auth != null;
    }

    // Chats and Messages: Participants can read/write
    match /chats/{chatId} {
      allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;

      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }
  }
}